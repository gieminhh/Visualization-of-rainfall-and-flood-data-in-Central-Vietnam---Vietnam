{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client"],
    "erasableSyntaxOnly": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.data.tsbuildinfo"
  },
  "include": ["scripts/**/*.ts", "tests/**/*.ts"]
}
